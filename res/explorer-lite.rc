// Icon, manifest and version of explorer-lite.exe. Task Manager shows FileDescription as its name.
// `just build <version>` passes EXPLORER_LITE_VERSION_RC (X,Y,Z,0) and EXPLORER_LITE_VERSION (the string).
#include <winver.h>

#ifndef EXPLORER_LITE_VERSION_RC
#define EXPLORER_LITE_VERSION_RC 0,1,0,0
#endif
#ifndef EXPLORER_LITE_VERSION
#define EXPLORER_LITE_VERSION "0.1.0"
#endif

1 ICON "explorer-lite.ico"
1 24 "explorer-lite.manifest"

1 VERSIONINFO
FILEVERSION EXPLORER_LITE_VERSION_RC
PRODUCTVERSION EXPLORER_LITE_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "justdiego"
      VALUE "FileDescription", "explorer-lite"
      VALUE "ProductName", "explorer-lite"
      VALUE "OriginalFilename", "explorer-lite.exe"
      VALUE "FileVersion", EXPLORER_LITE_VERSION
      VALUE "ProductVersion", EXPLORER_LITE_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
